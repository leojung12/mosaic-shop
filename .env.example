# Supabase 프로젝트 objet-shop (대시보드 → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 소셜 로그인 ---------------------------------------------------------------
# 실제로 켤 로그인 (Supabase·네이버 설정을 마친 것만). 비어 있으면 버튼은 '준비 중' 안내만 띄운다
NEXT_PUBLIC_AUTH_PROVIDERS=
# 구글·카카오: 키는 여기가 아니라 Supabase 대시보드 → Authentication → Sign In / Providers 에 넣는다.
# 네이버: Supabase가 지원하지 않아 우리 서버가 직접 처리한다 (developers.naver.com 애플리케이션)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 회원을 만들고 로그인시키는 데 필요 (대시보드 → Project Settings → API Keys → secret). 절대 공개 금지
SUPABASE_SERVICE_ROLE_KEY=

# 주문·결제
# ORDER_SECRET: 서버 비밀값 (openssl rand -hex 32). sha256 해시를 DB private.app_secret 에 넣는다
ORDER_SECRET=
# 토스페이먼츠 결제위젯 키 (테스트: test_gck_/test_gsk_, 실서비스: live_gck_/live_gsk_)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
